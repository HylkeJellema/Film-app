<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Clips are large and local by design; nothing is backed up or transferred. -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="external" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="external" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
